generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  gm
  rm
  bm
  sales
  purchasing
}

/// Notifikasi persisten per-user — riwayat semua kejadian penting pada RFQ/FUP A
/// yang relevan untuk penerimanya, ditampilkan di tab Notifikasi. Satu baris per
/// penerima (bukan satu baris disiarkan), supaya "tandai terbaca" murni per-baris
/// tanpa perlu tabel status-baca terpisah.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  entity    String // 'rfq' | 'fupa'
  entityId  String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  se           String?
  cabang       String?
  reg          Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  cabang    String?
  // Legacy single-PIC fields. Kept (not dropped) so old rows/exports/imports
  // keep working, but no longer edited directly from the form once `pics`
  // is in use — the API mirrors them from the primary entry in `pics` on
  // every save, so they always reflect "the" contact for call sites that
  // haven't been updated to read `pics` yet.
  pic       String?
  phone     String?
  email     String?
  address   String?
  catatan   String?
  // One or more contact persons at this company: [{id, nama, jabatan, phone,
  // email, isPrimary}], see CustomerPic in lib/types.ts. Nullable/empty for
  // customers that only ever had the legacy single pic/phone/email filled in.
  pics      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Foto kunjungan pada sebuah perjalanan dinas (lihat VisitTrip). File-nya di
/// object storage (seperti Attachment); `visitId` menunjuk TripVisit.id di
/// dalam VisitTrip.visits (JSON), jadi bukan foreign key.
model TripPhoto {
  id         String   @id @default(cuid())
  tripId     String
  visitId    String
  name       String
  type       String?
  size       Int      @default(0)
  key        String   @unique
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([tripId])
}

/// Perjalanan dinas GM / RM / BM ke customer di sebuah cabang: satu header
/// (siapa, ke cabang mana, kapan) dengan daftar kunjungan customer di
/// `visits` (JSON, seperti Rfq.items) -- masing-masing punya tujuan
/// (rencana) dan realisasi. Alur: draft -> diajukan -> disetujui/ditolak ->
/// selesai, atau batal. BM disetujui RM regionalnya, RM disetujui GM, GM
/// langsung disetujui saat diajukan.
model VisitTrip {
  id               String    @id @default(cuid())
  ownerId          String
  ownerName        String
  ownerRole        String
  ownerCabang      String?
  ownerReg         Int?
  /// Cabang tujuan perjalanan.
  cabang           String
  reg              Int?
  tglBerangkat     String
  tglPulang        String
  /// Maksud perjalanan secara umum.
  keperluan        String?
  visits           Json      @default("[]")
  status           String    @default("draft")
  submittedAt      DateTime?
  approverName     String?
  approvedAt       DateTime?
  approvalNote     String?
  catatanRealisasi String?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerId])
  @@index([cabang])
  @@index([status])
  @@index([tglBerangkat])
}

/// Aktivitas harian Sales (kunjungan, telepon, meeting, kirim dokumen).
/// Terpisah dari Prospect: satu customer bisa dikunjungi berkali-kali dan
/// sebagian besar aktivitas tidak pernah menjadi peluang. Bila menghasilkan
/// Permintaan/Penawaran/PO, tombol "Masukkan ke Pipeline" membuat Prospect dan
/// mengisi `prospectId` di sini (satu aktivitas -> paling banyak satu prospek).
model SalesActivity {
  id         String   @id @default(cuid())
  /// Hari aktivitas, "YYYY-MM-DD" (waktu lokal, sama seperti tglPenawaran).
  tanggal    String
  se         String
  /// Didenormalisasi dari akun saat disimpan (seperti SalesPlan) agar rollup
  /// per cabang/regional tidak perlu join ke tabel user.
  cabang     String?
  reg        Int?
  /// kunjungan | telepon | meeting | dokumen -- lihat ACTIVITY_TYPES.
  tipe       String
  customer   String
  /// Hasil/ringkasan singkat; juga dipakai sebagai uraian awal saat dikonversi.
  keterangan String?
  /// PIC customer yang ditemui/dihubungi: [{ nama, jabatan }], minimal satu.
  /// JSON seperti Customer.pics; baris lama (sebelum phase27) berisi [].
  pics       Json     @default("[]")
  prospectId String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tanggal])
  @@index([se])
  @@index([cabang])
  @@index([reg])
  @@index([prospectId])
}

/// Target aktivitas per SE per bulan, diisi atasan (BM/RM/GM/Admin). `targets`
/// = { kunjungan: n, telepon: n, meeting: n, dokumen: n }; tipe yang tidak
/// ada memakai DEFAULT_ACTIVITY_TARGETS.
model ActivityTarget {
  id        String   @id @default(cuid())
  se        String
  periode   String // "YYYY-MM"
  cabang    String?
  reg       Int?
  targets   Json     @default("{}")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([se, periode])
  @@index([periode])
}

// A single material line item inside Prospect.materials / Rfq.items is stored
// as JSON (see src/lib/types.ts for the shape) rather than a child table —
// it mirrors the original app's in-record arrays and keeps CRUD to one write.
model Prospect {
  id                String   @id @default(cuid())
  reg               Int?
  cabang            String?
  se                String?
  customer          String
  phone             String?
  tglPenawaran      String?
  /// Nomor PO/kontrak dari customer. Wajib diisi (ditegakkan di layer
  /// API, lihat POST/PUT/PATCH /api/prospects) begitu `status` dipindahkan
  /// ke 4 (PO/Kontrak) atau 5 (DO) -- DO tetap mensyaratkan PO karena
  /// secara alur selalu didahului PO, termasuk saat status dilompat
  /// langsung dari tahap sebelumnya tanpa pernah "mampir" di status 4.
  noPo              String?
  tglPO             String?
  tglDelivery       String?
  line              String?
  uraian            String?
  qty               Float    @default(0)
  value             Float    @default(0)
  materials         Json
  kondisiStock      String?
  keterangan        String?
  status            Int      @default(0)
  penawaranTerkirim Boolean  @default(false)
  terfaktur         Boolean  @default(false)
  /// Bumped only when `status` actually changes — aging measures time without
  /// progress, so a note edit must not reset the clock.
  statusChangedAt   DateTime @default(now())
  qcdQuality        String?
  qcdCost           String?
  qcdDelivery       String?
  qcdKompetitor     String?
  qcdCatatan        String?
  /// Jadwal follow-up berikutnya, diisi manual oleh Sales/BM — bukan
  /// dihitung otomatis seperti Aging (statusChangedAt). Dipakai dasbord
  /// Follow-up untuk menyatukan "sudah dijadwalkan" dengan sinyal otomatis
  /// (pipeline mangkrak, customer dingin) dalam satu tampilan.
  followUpAt        String?
  followUpNote      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([cabang])
  @@index([se])
  @@index([reg])
  @@index([followUpAt])
}

// `reg` is denormalized off the source Prospect at write time rather than
// joined at read time: rm-scoped queries filter on it directly, and a region
// can't be derived in SQL from `cabang` alone.
model Rfq {
  id          String   @id @default(cuid())
  /// Unik supaya dua RFQ tidak pernah memakai nomor yang sama. Nullable —
  /// Postgres mengizinkan banyak NULL pada unique index, jadi baris lama yang
  /// belum bernomor tidak saling bentrok.
  noRfq       String?  @unique
  tglRfq      String?
  cabang      String?
  reg         Int?
  customer    String?
  requestedBy String?
  prospectId  String?
  items       Json
  catatan     String?
  status      String   @default("Draft")
  // Purchasing-side ladder (PSTATUS_META), independent of the sales `status`.
  purchStatus Int      @default(0)
  // Set once this RFQ has been promoted into a FUP A purchase request.
  fupaId      String?
  // Purchasing's answer (per-item harga/COO lives inside `items`); these two
  // record that the answer was sent back to Sales.
  /// Stamped the first time the RFQ is marked Terkirim to Purchasing.
  sentToPurchasingAt DateTime?
  /// Stamped once, the first time a Purchasing/Admin user opens this
  /// document's detail — drives stage 2 "Diterima". Never re-stamped.
  openedByPurchasingAt DateTime?
  /// The only manually-set stage: Purchasing marks this when no vendor can
  /// quote at all. Loses to Dijawab/Selesai so a finished document never
  /// reverts. See lib/purchasing-workflow.ts.
  noQuote            Boolean   @default(false)
  jawabanRfqDikirim Boolean  @default(false)
  jawabanRfqAt      DateTime?
  /// Internal purchasing notes — not shown to Sales.
  purchNotes        String?
  /// Purchasing's written reply, visible to the Sales requester.
  purchJawaban      String?
  quotations  Quotation[]
  /// Pembatalan. Dokumen tetap tampil di daftar dengan status "Dibatalkan"
  /// beserta alasannya — bukan dihapus, supaya riwayatnya tetap terbaca.
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cabang])
  @@index([reg])
  @@index([requestedBy])
  @@index([purchStatus])
}

// Supplier directory for the purchasing module. National, not branch-scoped:
// purchasing sources for every cabang from the same vendor list.
model Vendor {
  id        String   @id @default(cuid())
  nama      String
  pic       String?
  wa        String?
  email     String?
  kategori  String?
  alamat    String?
  catatan    String?
  quotations Quotation[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([nama])
  @@index([kategori])
}

// FUP A — "Permintaan Pembelian", the purchase request raised from an RFQ the
// sales side has won. Shares the RfqItem shape (src/lib/types.ts) so the same
// line-item editor serves both documents.
model Fupa {
  id          String   @id @default(cuid())
  noFupa      String?
  tglFupa     String?
  sourceRfqId String?
  sourceNoRfq String?
  cabang      String?
  reg         Int?
  customer    String?
  requestedBy String?
  prospectId  String?
  items       Json
  catatan     String?
  status       String   @default("Draft")
  purchStatus  Int      @default(0)
  purchNotes   String?
  purchJawaban String?
  /// Stamped when the FUP A is handed to Purchasing — mirrors Rfq.sentToPurchasingAt.
  sentToPurchasingAt DateTime?
  /// Stamped once, the first time a Purchasing/Admin user opens this
  /// document's detail — drives stage 2 "Diterima". Never re-stamped.
  openedByPurchasingAt DateTime?
  /// The only manually-set stage: Purchasing marks this when no vendor can
  /// quote at all. Loses to Dijawab/Selesai so a finished document never
  /// reverts. See lib/purchasing-workflow.ts.
  noQuote            Boolean   @default(false)
  /// Set the first time Purchasing saves a non-empty purchJawaban. FUP A has no
  /// Harga/COO columns to key off the way Rfq does, so the written reply is the
  /// only signal that an answer was actually given.
  jawabanFupaDikirim Boolean  @default(false)
  jawabanFupaAt      DateTime?
  quotations   Quotation[]
  /// Pembatalan. Dokumen tetap tampil di daftar dengan status "Dibatalkan"
  /// beserta alasannya — bukan dihapus, supaya riwayatnya tetap terbaca.
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cabang])
  @@index([reg])
  @@index([requestedBy])
  @@index([purchStatus])
  @@index([sourceRfqId])
}

// One vendor's price response for an RFQ or FUP A. A real table rather than the
// prototype's embedded array: it keeps the vendor foreign key, makes "every
// quote from vendor X" answerable, and stops purchasing and sales clobbering
// each other's edits on the parent document.
model Quotation {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  rfqId       String?
  rfq         Rfq?     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fupaId      String?
  fupa        Fupa?    @relation(fields: [fupaId], references: [id], onDelete: Cascade)
  tglDiminta  String?
  channel     String?
  harga       Float    @default(0)
  leadTime    Int      @default(0)
  catatan     String?
  isWinner    Boolean  @default(false)
  requestedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
  @@index([rfqId])
  @@index([fupaId])
}

// Per-branch sales target for one period (YYYY-MM). Editable by admin/gm
// anywhere and by rm within their own region — see canEditBudgetTarget.
/// Rencana penjualan per Sales Engineer per bulan, dirinci per material.
/// `value` didenormalisasi (jumlah items[].qty*items[].harga) supaya rollup
/// cabang->regional->nasional di lib/reports.ts tidak perlu decode JSON tiap
/// baris saat menjumlah — sama pola dengan Prospect.value dari materials[].
model SalesPlan {
  id          String   @id @default(cuid())
  periode     String // "YYYY-MM"
  se          String
  /// Didenormalisasi dari akun/cabang pembuatnya saat disimpan, sama seperti
  /// Rfq/Fupa, supaya rollup per cabang tidak perlu join ke tabel user.
  cabang      String?
  reg         Int?
  items       Json     @default("[]")
  value       Float    @default(0)
  requestedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Satu rencana per SE per bulan — mengisi ulang bulan yang sama meng-
  /// update baris ini, bukan menambah baris baru.
  @@unique([se, periode])
  @@index([periode])
  @@index([cabang])
  @@index([reg])
}

model BudgetTarget {
  id        String   @id @default(cuid())
  cabang    String
  periode   String
  amount    Float    @default(0)
  /// Target Gross Margin (%) untuk KPI Scorecard — belum bisa dihitung
  /// otomatis, menunggu integrasi Sage 300, jadi tetap diisi manual.
  grossMarginTarget Float?
  /// Hasil aktual Gross Margin (%) bulan itu — diisi manual dengan alasan
  /// yang sama, dan dengan nilai yang sama pula (target vs hasil), sampai
  /// integrasi selesai.
  grossMarginResult Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cabang, periode])
  @@index([periode])
}

// Team chat. Replaces the prototype's polling (an 8s timer over a single
// JSON blob) with rows pushed over the existing Socket.IO connection.
// `members` holds usernames rather than user ids so a conversation survives
// a user row being recreated, matching how ActivityLog snapshots its actor.
model Conversation {
  id        String   @id @default(cuid())
  type      String
  name      String?
  members   String[]
  createdBy String
  messages  Message[]
  reads     ConversationRead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         String
  authorUsername String
  role           String?
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Per-user read cursor, kept out of Conversation so one person opening a
// thread never writes to a row everyone else is reading.
model ConversationRead {
  id             String       @id @default(cuid())
  username       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([username, conversationId])
  @@index([username])
}

// Per-record discussion thread on a prospect / RFQ / FUP A. Kept separate from
// the team-chat Conversation model: these threads are attached to a document
// rather than to a set of people, and everyone who can see the document can
// read them, so there is no membership list.
model ItemMessage {
  id             String   @id @default(cuid())
  entity         String
  entityId       String
  author         String
  authorUsername String
  role           String?
  text           String
  createdAt      DateTime @default(now())

  @@index([entity, entityId, createdAt])
}

// Per-user read cursor for one item thread.
model ItemRead {
  id         String   @id @default(cuid())
  username   String
  entity     String
  entityId   String
  lastReadAt DateTime @default(now())

  @@unique([username, entity, entityId])
  @@index([username])
}

// File attachments for RFQ / FUP A. Bytes live in S3-compatible object storage
// (see src/lib/s3.ts); only the key and display metadata are stored here. The
// single-file prototype inlined 1.5MB base64 data URLs in the record itself,
// which is why its limit was so low.
model Attachment {
  id         String   @id @default(cuid())
  rfqId      String?
  fupaId     String?
  name       String
  type       String?
  size       Int      @default(0)
  key        String   @unique
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([rfqId])
  @@index([fupaId])
}

// Small key/value bag for app-wide settings — currently just the
// remembered Purchasing WhatsApp/email contact used to prefill the RFQ modal.
model Setting {
  key   String @id
  value Json
}

enum ActivityAction {
  login
  login_failed
  logout
  create
  update
  status_change
  delete
  import
  export
  restore
}

enum ActivityEntity {
  prospect
  customer
  rfq
  user
  setting
  database
  session
  vendor
  fupa
  quotation
  budget
  salesPlan
  salesActivity
  activityTarget
  visitTrip
  chat
}

// Append-only audit trail. Every actor field is a *snapshot* taken at write
// time rather than a relation: an audit log has to stay readable after the
// user row is renamed, re-scoped, or deleted, so there is deliberately no
// foreign key back to User. actorCabang/actorReg are copied for the same
// reason — they let rm/bm read their own team's history (see
// activityScopeWhere) without joining a row that may no longer exist.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId      String?
  username    String
  actorName   String
  role        Role?
  actorCabang String?
  actorReg    Int?

  action   ActivityAction
  entity   ActivityEntity
  entityId String?
  /// Pre-rendered Indonesian one-liner, so the UI never has to reconstruct
  /// what an old record used to mean after labels or code change.
  summary  String
  /// Field-level diff for updates: { field: { from, to } }. Null otherwise.
  changes  Json?
  ip       String?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([actorCabang])
  @@index([actorReg])
}
