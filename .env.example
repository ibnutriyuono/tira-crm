# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://tira_crm:tira_crm@localhost:5432/tira_crm?schema=public"

# Secret used to sign session JWTs — set a long random string in production.
JWT_SECRET="change-this-to-a-long-random-string"

# Port the custom Next.js + Socket.IO server listens on.
PORT=3000

# Deployment stage. Only the literal value "development" runs Next's
# unoptimized dev server (see package.json's "dev" script) — every other
# value (production, uat, staging, ...) serves the build from `npm run
# build`, so `npm start` must be run after a build.
NODE_ENV=production

# Session cookie's Secure flag. Browsers silently drop Secure cookies over
# plain HTTP, so set this to "false" for any deployment not sitting behind
# TLS (e.g. accessed directly via IP:port) — otherwise login will appear to
# do nothing. Defaults to secure (true) when unset.
COOKIE_SECURE=true
